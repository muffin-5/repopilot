# RepoPilot Backend - Environment Configuration
# Copy this file to .env and configure your preferences

# ── Google Gemini Configuration (Recommended) ───────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
# Alternative Gemini models:
# LLM_MODEL=gemini-2.0-flash
# LLM_MODEL=gemini-1.5-pro

# ── Or OpenAI / Other Providers (Optional) ──────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=

# ── Embedding Configuration ─────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Qdrant Vector Store Configuration ────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=repopilot_chunks

# ── Retrieval & Chunking Configuration ───────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
USE_RERANKER=false

# ── Application Configuration ────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DATA_DIR=./data
