# Copy this file to .env on the EC2 instance. Do not commit .env or share its values.
APP_ENV=production
LOG_LEVEL=INFO

# Create this key in Google AI Studio.
GEMINI_API_KEY=replace_with_your_gemini_key
LLM_MODEL=gemini-1.5-flash

# Use the HTTPS cluster endpoint and database API key from Qdrant Cloud.
QDRANT_URL=https://replace_with_your_cluster.cloud.qdrant.io
QDRANT_API_KEY=replace_with_your_qdrant_database_api_key
QDRANT_COLLECTION=repopilot_chunks

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
USE_RERANKER=false

# The browser calls /api through Nginx, so this is only needed for direct API use.
CORS_ORIGINS=["http://localhost"]
DATA_DIR=/app/data
